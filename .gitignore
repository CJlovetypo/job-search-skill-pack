# Only distributable roots belong in this repository.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/LICENSE
!/job-radar/
!/shared/
!/job-search/
/shared/*
!/shared/job-search-core/

# Internal instructions, product planning and historical research remain local.
**/AGENTS.md
**/agents.md
**/PRD.md
**/ARCHITECTURE.md
**/internal/
**/data/registry-inheritance.json
/shared/job-search-core/references/implementation-validation-*.md
/shared/job-search-core/data/feishu-expansion-*.json
/shared/job-search-core/data/source-verification-*.json

# Personal materials, captured data, reports and development evidence.
**/runs/
**/outputs/
/job-radar/state/
**/artifacts/
**/tmp/
**/logs/
**/tmp-*/
/shared/job-search-core/state/
*.repair.lock

# Dependencies, caches and local credentials.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
coverage/
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
credentials.json
cookies.txt
cookies.json

# Editor and temporary files.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.log
*.tmp
*.swp
~$*

# Maintenance originals and process records; published runtime data remain public.
/datasets/
/maintenance/
/docs/
/shared/job-search-core/evals/
/shared/job-search-core/data/company-label-reviews.json
/shared/job-search-core/data/company-research-candidates.json.gz
/shared/job-search-core/data/company-api-labels.json.gz
/shared/job-search-core/assets/waiqi-source-candidates.json
/shared/job-search-core/assets/waiqi-interface-catalog.json
/shared/job-search-core/assets/waiqi-interface-review-index.json
/shared/job-search-core/data/waiqi-foreign-company-index.json
/shared/job-search-core/data/.publication-state.json
